#version 450 core


layout(
    local_size_x = 4,
    local_size_y = 4,
    local_size_z = 4)
in;


// =============================================================
// OUTPUT
// =============================================================

layout(
    r16f,
    binding = 0)
uniform writeonly image3D densityImage;


// =============================================================
// FORMATION
// =============================================================

uniform float formationHorizontalRadiusKm;

uniform float formationHeightKm;

uniform float formationSeed;


// =============================================================
// HASHES
// =============================================================

float hash31(
    vec3 p)
{
    p =
        fract(
            p *
            0.1031);


    p +=
        dot(
            p,
            p.yzx +
            33.33);


    return
        fract(
            (
                p.x +
                p.y
            )
            *
            p.z);
}


vec3 hash33(
    vec3 p)
{
    p =
        fract(
            p *
            vec3(
                0.1031,
                0.11369,
                0.13787));


    p +=
        dot(
            p,
            p.yxz +
            19.19);


    return
        fract(
            (
                p.xxy +
                p.yxx
            )
            *
            p.zyx);
}


// =============================================================
// VALUE NOISE
// =============================================================

float valueNoise(
    vec3 p)
{
    vec3 cell =
        floor(
            p);


    vec3 local =
        fract(
            p);


    local =
        local *
        local *
        (
            3.0 -
            2.0 *
            local
        );


    float n000 =
        hash31(
            cell +
            vec3(
                0.0,
                0.0,
                0.0));


    float n100 =
        hash31(
            cell +
            vec3(
                1.0,
                0.0,
                0.0));


    float n010 =
        hash31(
            cell +
            vec3(
                0.0,
                1.0,
                0.0));


    float n110 =
        hash31(
            cell +
            vec3(
                1.0,
                1.0,
                0.0));


    float n001 =
        hash31(
            cell +
            vec3(
                0.0,
                0.0,
                1.0));


    float n101 =
        hash31(
            cell +
            vec3(
                1.0,
                0.0,
                1.0));


    float n011 =
        hash31(
            cell +
            vec3(
                0.0,
                1.0,
                1.0));


    float n111 =
        hash31(
            cell +
            vec3(
                1.0,
                1.0,
                1.0));


    float nx00 =
        mix(
            n000,
            n100,
            local.x);


    float nx10 =
        mix(
            n010,
            n110,
            local.x);


    float nx01 =
        mix(
            n001,
            n101,
            local.x);


    float nx11 =
        mix(
            n011,
            n111,
            local.x);


    float nxy0 =
        mix(
            nx00,
            nx10,
            local.y);


    float nxy1 =
        mix(
            nx01,
            nx11,
            local.y);


    return
        mix(
            nxy0,
            nxy1,
            local.z);
}


// =============================================================
// LOW-FREQUENCY FBM
// =============================================================

float macroFbm(
    vec3 positionKm,
    float wavelengthKm)
{
    float accumulated =
        0.0;


    float totalWeight =
        0.0;


    float amplitude =
        0.57;


    vec3 p =
        positionKm;


    for (int octave = 0;
         octave < 3;
         ++octave)
    {
        vec3 coordinate =
            p /
            wavelengthKm;


        coordinate +=
            vec3(
                formationSeed *
                    0.071,
                formationSeed *
                    0.113,
                formationSeed *
                    0.173);


        accumulated +=
            valueNoise(
                coordinate)
            *
            amplitude;


        totalWeight +=
            amplitude;


        p =
            mat3(
                 0.00,  0.80,  0.60,
                -0.80,  0.36, -0.48,
                -0.60, -0.48,  0.64)
            *
            p
            +
            vec3(
                1.7,
                -0.9,
                2.3);


        wavelengthKm *=
            0.5;


        amplitude *=
            0.5;
    }


    return
        accumulated /
        max(
            totalWeight,
            0.0001);
}


// =============================================================
// WORLEY F1
// =============================================================

float worleyF1(
    vec3 coordinate,
    float seedOffset)
{
    vec3 baseCell =
        floor(
            coordinate);


    vec3 local =
        fract(
            coordinate);


    float minimumDistanceSquared =
        1000.0;


    vec3 seedVector =
        vec3(
            seedOffset *
                0.137,
            seedOffset *
                0.219,
            seedOffset *
                0.317);


    for (int z = -1;
         z <= 1;
         ++z)
    {
        for (int y = -1;
             y <= 1;
             ++y)
        {
            for (int x = -1;
                 x <= 1;
                 ++x)
            {
                vec3 neighbor =
                    vec3(
                        float(
                            x),
                        float(
                            y),
                        float(
                            z));


                vec3 featurePoint =
                    hash33(
                        baseCell +
                        neighbor +
                        seedVector);


                vec3 difference =
                    neighbor +
                    featurePoint -
                    local;


                minimumDistanceSquared =
                    min(
                        minimumDistanceSquared,
                        dot(
                            difference,
                            difference));
            }
        }
    }


    return
        sqrt(
            minimumDistanceSquared);
}


// =============================================================
// CELLULAR BILLOW
// =============================================================

float cellularBillow(
    vec3 positionKm,
    float cellSizeKm,
    float seedOffset)
{
    float distance =
        worleyF1(
            positionKm /
            max(
                cellSizeKm,
                0.001),
            seedOffset);


    return
        1.0 -
        smoothstep(
            0.25,
            0.78,
            distance);
}


// =============================================================
// SUPPORT SHAPE
// =============================================================

float ellipsoidField(
    vec3 position,
    vec3 center,
    vec3 radii)
{
    vec3 normalizedPosition =
        (
            position -
            center
        )
        /
        max(
            radii,
            vec3(
                0.001));


    return
        1.0 -
        length(
            normalizedPosition);
}


// =============================================================
// BROAD CLOUD SUPPORT
// =============================================================
//
// These only establish where cloud is allowed to exist.
//
// Cellular carving later creates the actual surface.

float supportField(
    vec3 p)
{
    float radius =
        formationHorizontalRadiusKm;


    float height =
        formationHeightKm;


    float field =
        -1000.0;


    // Lower connected mass.

    field =
        max(
            field,
            ellipsoidField(
                p,
                vec3(
                    -radius *
                        0.03,
                    -height *
                        0.29,
                    radius *
                        0.01),
                vec3(
                    radius *
                        0.54,
                    height *
                        0.25,
                    radius *
                        0.49)));


    // Central updraft.

    field =
        max(
            field,
            ellipsoidField(
                p,
                vec3(
                    -radius *
                        0.015,
                    -height *
                        0.015,
                    -radius *
                        0.025),
                vec3(
                    radius *
                        0.31,
                    height *
                        0.40,
                    radius *
                        0.29)));


    // Left region.

    field =
        max(
            field,
            ellipsoidField(
                p,
                vec3(
                    -radius *
                        0.31,
                    -height *
                        0.085,
                    radius *
                        0.055),
                vec3(
                    radius *
                        0.245,
                    height *
                        0.31,
                    radius *
                        0.225)));


    // Right region.

    field =
        max(
            field,
            ellipsoidField(
                p,
                vec3(
                    radius *
                        0.31,
                    -height *
                        0.095,
                    -radius *
                        0.06),
                vec3(
                    radius *
                        0.245,
                    height *
                        0.30,
                    radius *
                        0.225)));


    // Rear region.

    field =
        max(
            field,
            ellipsoidField(
                p,
                vec3(
                    -radius *
                        0.075,
                    -height *
                        0.045,
                    radius *
                        0.28),
                vec3(
                    radius *
                        0.215,
                    height *
                        0.29,
                    radius *
                        0.20)));


    // Front region.

    field =
        max(
            field,
            ellipsoidField(
                p,
                vec3(
                    radius *
                        0.105,
                    -height *
                        0.11,
                    -radius *
                        0.28),
                vec3(
                    radius *
                        0.205,
                    height *
                        0.26,
                    radius *
                        0.19)));


    // Upper crown.

    field =
        max(
            field,
            ellipsoidField(
                p,
                vec3(
                    -radius *
                        0.035,
                    height *
                        0.29,
                    -radius *
                        0.01),
                vec3(
                    radius *
                        0.245,
                    height *
                        0.225,
                    radius *
                        0.235)));


    return
        field;
}


// =============================================================
// CELLULAR DOMAIN WARP
// =============================================================

vec3 cellularWarp(
    vec3 p,
    float wavelengthKm)
{
    vec3 coordinate =
        p /
        wavelengthKm;


    coordinate +=
        vec3(
            formationSeed *
                0.037,
            formationSeed *
                0.061,
            formationSeed *
                0.097);


    vec3 warp;


    warp.x =
        valueNoise(
            coordinate +
            vec3(
                4.1,
                -7.2,
                2.8))
        -
        0.5;


    warp.y =
        valueNoise(
            coordinate +
            vec3(
                -3.7,
                1.9,
                8.3))
        -
        0.5;


    warp.z =
        valueNoise(
            coordinate +
            vec3(
                6.4,
                5.1,
                -4.6))
        -
        0.5;


    return
        warp;
}


// =============================================================
// FINE SURFACE FIELD
// =============================================================

float fineErosionField(
    vec3 positionKm,
    float fineScaleKm)
{
    float first =
        valueNoise(
            (
                positionKm +
                vec3(
                    7.1,
                    -3.7,
                    11.3)
            )
            /
            fineScaleKm
            +
            vec3(
                formationSeed *
                    0.171));


    float second =
        valueNoise(
            (
                positionKm +
                vec3(
                    -5.6,
                    8.9,
                    2.4)
            )
            /
            (
                fineScaleKm *
                0.53
            )
            +
            vec3(
                formationSeed *
                    0.271));


    return
        first *
        0.68
        +
        second *
        0.32;
}


// =============================================================
// OPTICAL DENSITY REMAP
// =============================================================
//
// IMPORTANT:
//
// "body" answers:
//
//     how strongly this voxel belongs to the cloud shape.
//
// It should not map linearly to optical density.
//
// Real-looking behavior:
//
//     thin boundary:
//         low condensed material / partially transparent
//
//     established body:
//         density rises rapidly
//
//     deep core:
//         optically thick
//
// This remap DOES NOT change the cloud geometry.
// It only changes material density inside that geometry.

float remapOpticalDensity(
    float body)
{
    body =
        clamp(
            body,
            0.0,
            1.0);


    // ---------------------------------------------------------
    // OUTER BOUNDARY
    // ---------------------------------------------------------

    float boundaryWeight =
        smoothstep(
            0.02,
            0.18,
            body);


    // ---------------------------------------------------------
    // DEEP CLOUD CORE
    // ---------------------------------------------------------

    float coreWeight =
        smoothstep(
            0.30,
            0.72,
            body);


    // Thin edges retain transparency.

    float shellDensity =
        body *
        0.50;


    // Established cloud volume is substantially denser.

    float bulkDensity =
        body *
        0.95;


    float density =
        mix(
            shellDensity,
            bulkDensity,
            boundaryWeight);


    // Deep interiors approach full density quickly.

    density =
        mix(
            density,
            1.0,
            coreWeight *
            0.82);


    return
        clamp(
            density,
            0.0,
            1.0);
}


// =============================================================
// FINAL DENSITY GENERATOR
// =============================================================

float generateDensity(
    vec3 localPositionKm)
{
    float radius =
        formationHorizontalRadiusKm;


    float height =
        formationHeightKm;


    // =========================================================
    // NORMALIZED HEIGHT
    // =========================================================

    float height01 =
        (
            localPositionKm.y +
            height *
                0.5
        )
        /
        height;


    if (
        height01 <=
            0.0
        ||
        height01 >=
            1.0)
    {
        return
            0.0;
    }


    // =========================================================
    // CONDENSATION BASE / CLOUD TOP
    // =========================================================

    float baseFade =
        smoothstep(
            0.012,
            0.055,
            height01);


    float topFade =
        1.0 -
        smoothstep(
            0.955,
            1.0,
            height01);


    if (
        baseFade <=
            0.0001
        ||
        topFade <=
            0.0001)
    {
        return
            0.0;
    }


    // =========================================================
    // BROAD SUPPORT
    // =========================================================

    float rawSupport =
        supportField(
            localPositionKm);


    // Reject clearly empty voxels before expensive Worley work.

    if (rawSupport <
        -0.38)
    {
        return
            0.0;
    }


    // =========================================================
    // PHYSICAL DETAIL SCALES
    // =========================================================

    float scaleReferenceKm =
        min(
            radius,
            height *
                0.70);


    float macroWavelengthKm =
        max(
            2.4,
            scaleReferenceKm *
                0.92);


    float largeCellKm =
        max(
            1.25,
            scaleReferenceKm *
                0.48);


    float mediumCellKm =
        max(
            0.62,
            scaleReferenceKm *
                0.235);


    float fineScaleKm =
        max(
            0.24,
            scaleReferenceKm *
                0.085);


    // =========================================================
    // VERTICAL DEVELOPMENT
    // =========================================================

    float development =
        smoothstep(
            0.10,
            0.78,
            height01);


    // =========================================================
    // SUPPORT DEFORMATION
    // =========================================================

    float supportNoise =
        macroFbm(
            localPositionKm,
            macroWavelengthKm);


    float supportDeformation =
        (
            supportNoise -
            0.5
        )
        *
        mix(
            0.10,
            0.24,
            development);


    float shapeField =
        rawSupport +
        supportDeformation;


    // =========================================================
    // CELLULAR COORDINATES
    // =========================================================

    vec3 warp =
        cellularWarp(
            localPositionKm,
            max(
                scaleReferenceKm *
                    0.72,
                2.0));


    float warpStrengthKm =
        mix(
            0.10,
            0.52,
            development);


    vec3 cellularPositionKm =
        localPositionKm +
        warp *
        warpStrengthKm;


    // =========================================================
    // LARGE CELLULAR STRUCTURE
    // =========================================================

    float largeBillows =
        cellularBillow(
            cellularPositionKm,
            largeCellKm,
            formationSeed +
                13.7);


    // =========================================================
    // MEDIUM CELLULAR STRUCTURE
    // =========================================================

    float mediumBillows =
        cellularBillow(
            cellularPositionKm +
            vec3(
                1.7,
                -0.8,
                2.3),
            mediumCellKm,
            formationSeed +
                41.3);


    // =========================================================
    // LARGE VALLEY CARVING
    // =========================================================

    float largeCavity =
        1.0 -
        largeBillows;


    float largeCarveStrength =
        mix(
            0.055,
            0.34,
            development);


    largeCarveStrength *=
        smoothstep(
            0.06,
            0.32,
            height01);


    shapeField -=
        largeCavity *
        largeCarveStrength;


    // =========================================================
    // MEDIUM VALLEY CARVING
    // =========================================================

    float mediumCavity =
        1.0 -
        mediumBillows;


    float mediumCarveStrength =
        mix(
            0.025,
            0.24,
            development);


    mediumCarveStrength *=
        smoothstep(
            0.10,
            0.40,
            height01);


    shapeField -=
        mediumCavity *
        largeBillows *
        mediumCarveStrength;


    // =========================================================
    // UPPER-CLOUD BREAKUP
    // =========================================================

    float upperBreakup =
        smoothstep(
            0.62,
            0.90,
            height01);


    float combinedCavity =
        max(
            largeCavity,
            mediumCavity *
                0.72);


    shapeField -=
        combinedCavity *
        upperBreakup *
        0.10;


    // =========================================================
    // SHAPE → BODY
    // =========================================================
    //
    // All meaningful geometry carving has happened before here.

    float densityThreshold =
        mix(
            -0.075,
            -0.015,
            development);


    densityThreshold +=
        upperBreakup *
        0.025;


    float body =
        smoothstep(
            densityThreshold -
                0.055,
            densityThreshold +
                0.080,
            shapeField);


    body *=
        baseFade *
        topFade;


    if (body <=
        0.0001)
    {
        return
            0.0;
    }


    // =========================================================
    // FINE EDGE EROSION
    // =========================================================

    float fineErosion =
        fineErosionField(
            cellularPositionKm,
            fineScaleKm);


    float edgeExposure =
        1.0 -
        smoothstep(
            0.30,
            0.82,
            body);


    float verticalErosion =
        mix(
            0.18,
            1.0,
            smoothstep(
                0.07,
                0.30,
                height01));


    float fineStrength =
        mix(
            0.10,
            0.32,
            development);


    body -=
        (
            1.0 -
            fineErosion
        )
        *
        edgeExposure
        *
        fineStrength
        *
        verticalErosion;


    body =
        max(
            body,
            0.0);


    // =========================================================
    // FINAL SHAPE REMAP
    // =========================================================

    body =
        smoothstep(
            0.015,
            0.80,
            body);


    // =========================================================
    // SHAPE → OPTICAL MATERIAL DENSITY
    // =========================================================
    //
    // New in this pass.
    //
    // Keep the exact geometry we just established, but make deep
    // established cloud substantially denser than its boundary.

    float opticalDensity =
        remapOpticalDensity(
            body);


    return
        opticalDensity;
}


// =============================================================
// MAIN
// =============================================================

void main()
{
    ivec3 size =
        imageSize(
            densityImage);


    ivec3 voxel =
        ivec3(
            gl_GlobalInvocationID.xyz);


    if (any(
            greaterThanEqual(
                voxel,
                size)))
    {
        return;
    }


    vec3 uvw =
        (
            vec3(
                voxel)
            +
            0.5
        )
        /
        vec3(
            size);


    vec3 halfBoundsKm =
        vec3(
            formationHorizontalRadiusKm *
                1.10,

            formationHeightKm *
                0.53,

            formationHorizontalRadiusKm *
                1.10);


    vec3 localPositionKm =
        (
            uvw *
            2.0 -
            1.0
        )
        *
        halfBoundsKm;


    float density =
        generateDensity(
            localPositionKm);


    imageStore(
        densityImage,
        voxel,
        vec4(
            density,
            0.0,
            0.0,
            1.0));
}