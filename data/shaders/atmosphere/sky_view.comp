#version 450 core


layout(
    local_size_x = 8,
    local_size_y = 8,
    local_size_z = 1
) in;


layout(binding = 2)
uniform sampler2D transmittanceLut;


layout(binding = 3)
uniform sampler2D multipleScatteringLut;


layout(
    rgba16f,
    binding = 0
)
writeonly uniform image2D skyViewLut;


// =============================================================
// ATMOSPHERE
// =============================================================

uniform float bottomRadiusKm;
uniform float topRadiusKm;


uniform vec3 rayleighScatteringPerKm;
uniform float rayleighScaleHeightKm;


uniform vec3 mieScatteringPerKm;
uniform vec3 mieExtinctionPerKm;
uniform float mieScaleHeightKm;
uniform float mieAnisotropy;


uniform vec3 ozoneAbsorptionPerKm;
uniform float ozoneCenterHeightKm;
uniform float ozoneHalfWidthKm;


// =============================================================
// VIEW / SUN
// =============================================================

uniform float cameraAltitudeKm;

uniform float sunZenithCosine;

uniform vec3 sunRadiance;


// =============================================================
// CONSTANTS
// =============================================================

const float PI =
    3.14159265359;


const int VIEW_SAMPLE_COUNT =
    48;


// =============================================================
// DENSITY
// =============================================================

float rayleighDensity(
    float altitudeKm)
{
    return exp(
        -max(
            altitudeKm,
            0.0)
        /
        rayleighScaleHeightKm);
}


float mieDensity(
    float altitudeKm)
{
    return exp(
        -max(
            altitudeKm,
            0.0)
        /
        mieScaleHeightKm);
}


float ozoneDensity(
    float altitudeKm)
{
    float distanceFromLayer =
        abs(
            altitudeKm -
            ozoneCenterHeightKm);


    return max(
        0.0,
        1.0 -
        distanceFromLayer /
        ozoneHalfWidthKm);
}


vec3 scatteringAtAltitude(
    float altitudeKm)
{
    return
        rayleighScatteringPerKm *
        rayleighDensity(
            altitudeKm)
        +
        mieScatteringPerKm *
        mieDensity(
            altitudeKm);
}


vec3 extinctionAtAltitude(
    float altitudeKm)
{
    return
        rayleighScatteringPerKm *
        rayleighDensity(
            altitudeKm)
        +
        mieExtinctionPerKm *
        mieDensity(
            altitudeKm)
        +
        ozoneAbsorptionPerKm *
        ozoneDensity(
            altitudeKm);
}


// =============================================================
// RAY / SPHERE
// =============================================================

float nearestSphereIntersection(
    vec3 origin,
    vec3 direction,
    float radius)
{
    float b =
        dot(
            origin,
            direction);


    float c =
        dot(
            origin,
            origin)
        -
        radius *
        radius;


    float discriminant =
        b *
        b -
        c;


    if (discriminant < 0.0)
    {
        return
            -1.0;
    }


    float root =
        sqrt(
            discriminant);


    float nearDistance =
        -b -
        root;


    float farDistance =
        -b +
        root;


    if (nearDistance > 0.0001)
    {
        return
            nearDistance;
    }


    if (farDistance > 0.0001)
    {
        return
            farDistance;
    }


    return
        -1.0;
}


bool rayHitsGround(
    vec3 position,
    vec3 direction)
{
    return
        nearestSphereIntersection(
            position,
            direction,
            bottomRadiusKm)
        >
        0.0001;
}


// =============================================================
// TRANSMITTANCE
// =============================================================

vec2 transmittanceUv(
    vec3 position,
    vec3 direction)
{
    float radius =
        length(
            position);


    vec3 localUp =
        position /
        radius;


    float mu =
        clamp(
            dot(
                localUp,
                direction),
            -1.0,
            1.0);


    float H =
        sqrt(
            max(
                topRadiusKm *
                topRadiusKm
                -
                bottomRadiusKm *
                bottomRadiusKm,
                0.0));


    float rho =
        sqrt(
            max(
                radius *
                radius
                -
                bottomRadiusKm *
                bottomRadiusKm,
                0.0));


    float discriminant =
        radius *
        radius *
        (
            mu *
            mu -
            1.0
        )
        +
        topRadiusKm *
        topRadiusKm;


    float distanceToTop =
        -radius *
        mu
        +
        sqrt(
            max(
                discriminant,
                0.0));


    float distanceMinimum =
        topRadiusKm -
        radius;


    float distanceMaximum =
        rho +
        H;


    float xMu =
        (
            distanceToTop -
            distanceMinimum
        )
        /
        max(
            distanceMaximum -
            distanceMinimum,
            0.000001);


    float xRadius =
        rho /
        max(
            H,
            0.000001);


    vec2 parameterUv =
        clamp(
            vec2(
                xMu,
                xRadius),
            vec2(0.0),
            vec2(1.0));


    vec2 textureSizePixels =
        vec2(
            textureSize(
                transmittanceLut,
                0));


    return
        (
            parameterUv *
            (
                textureSizePixels -
                vec2(1.0)
            )
            +
            vec2(0.5)
        )
        /
        textureSizePixels;
}


vec3 sampleTransmittanceToSpace(
    vec3 position,
    vec3 direction)
{
    if (rayHitsGround(
            position,
            direction))
    {
        return
            vec3(0.0);
    }


    return textureLod(
        transmittanceLut,
        transmittanceUv(
            position,
            direction),
        0.0).rgb;
}


vec3 sampleMultipleScattering(
    vec3 position,
    vec3 sunDirection)
{
    float radius =
        length(
            position);


    vec3 localUp =
        position /
        radius;


    float sunMu =
        clamp(
            dot(
                localUp,
                sunDirection),
            -1.0,
            1.0);


    float u =
        sunMu *
        0.5 +
        0.5;


    float atmosphereThickness =
        topRadiusKm -
        bottomRadiusKm;


    float altitudeKm =
        radius -
        bottomRadiusKm;


    float v =
        clamp(
            altitudeKm /
            atmosphereThickness,
            0.0,
            1.0);


    return textureLod(
        multipleScatteringLut,
        vec2(
            u,
            v),
        0.0).rgb;
}


// =============================================================
// PHASE FUNCTIONS
// =============================================================

float rayleighPhase(
    float cosTheta)
{
    return
        3.0 /
        (
            16.0 *
            PI
        )
        *
        (
            1.0 +
            cosTheta *
            cosTheta
        );
}


float miePhase(
    float cosTheta,
    float g)
{
    float g2 =
        g *
        g;


    float denominator =
        1.0 +
        g2 -
        2.0 *
        g *
        cosTheta;


    return
        (
            1.0 -
            g2
        )
        /
        (
            4.0 *
            PI *
            pow(
                max(
                    denominator,
                    0.0001),
                1.5)
        );
}


// =============================================================
// SKY DIRECTION
// =============================================================

vec3 buildViewDirection(
    vec2 uv)
{
    float azimuth =
        (
            uv.x *
            2.0 -
            1.0
        )
        *
        PI;


    float zenithAngle =
        uv.y *
        PI;


    float sinZenith =
        sin(
            zenithAngle);


    return normalize(
        vec3(
            cos(
                azimuth)
            *
            sinZenith,

            sin(
                azimuth)
            *
            sinZenith,

            cos(
                zenithAngle)));
}


// =============================================================
// MAIN
// =============================================================

void main()
{
    ivec2 size =
        imageSize(
            skyViewLut);


    ivec2 pixel =
        ivec2(
            gl_GlobalInvocationID.xy);


    if (pixel.x >= size.x ||
        pixel.y >= size.y)
    {
        return;
    }


    vec2 uv =
        (
            vec2(pixel) +
            vec2(0.5)
        )
        /
        vec2(size);


    float cameraRadius =
        bottomRadiusKm +
        cameraAltitudeKm;


    vec3 cameraPosition =
        vec3(
            0.0,
            0.0,
            cameraRadius);


    vec3 viewDirection =
        buildViewDirection(
            uv);


    float safeSunCosine =
        clamp(
            sunZenithCosine,
            -1.0,
            1.0);


    float sunHorizontal =
        sqrt(
            max(
                1.0 -
                safeSunCosine *
                safeSunCosine,
                0.0));


    vec3 sunDirection =
        normalize(
            vec3(
                sunHorizontal,
                0.0,
                safeSunCosine));


    float distanceToAtmosphere =
        nearestSphereIntersection(
            cameraPosition,
            viewDirection,
            topRadiusKm);


    if (distanceToAtmosphere < 0.0)
    {
        imageStore(
            skyViewLut,
            pixel,
            vec4(
                0.0,
                0.0,
                0.0,
                1.0));

        return;
    }


    float distanceToGround =
        nearestSphereIntersection(
            cameraPosition,
            viewDirection,
            bottomRadiusKm);


    float rayLength =
        distanceToAtmosphere;


    if (distanceToGround > 0.0 &&
        distanceToGround <
        rayLength)
    {
        rayLength =
            distanceToGround;
    }


    float stepLength =
        rayLength /
        float(
            VIEW_SAMPLE_COUNT);


    float scatteringAngleCosine =
        clamp(
            dot(
                viewDirection,
                sunDirection),
            -1.0,
            1.0);


    float phaseRayleigh =
        rayleighPhase(
            scatteringAngleCosine);


    float phaseMie =
        miePhase(
            scatteringAngleCosine,
            mieAnisotropy);


    vec3 accumulatedRadiance =
        vec3(0.0);


    vec3 viewTransmittance =
        vec3(1.0);


    for (int i = 0;
         i < VIEW_SAMPLE_COUNT;
         ++i)
    {
        float distanceAlongRay =
            (
                float(i) +
                0.5
            )
            *
            stepLength;


        vec3 samplePosition =
            cameraPosition +
            viewDirection *
            distanceAlongRay;


        float altitudeKm =
            max(
                length(
                    samplePosition)
                -
                bottomRadiusKm,
                0.0);


        float densityRayleigh =
            rayleighDensity(
                altitudeKm);


        float densityMie =
            mieDensity(
                altitudeKm);


        vec3 localScattering =
            scatteringAtAltitude(
                altitudeKm);


        vec3 localExtinction =
            extinctionAtAltitude(
                altitudeKm);


        vec3 segmentTransmittance =
            exp(
                -localExtinction *
                stepLength);


        vec3 midpointViewTransmittance =
            viewTransmittance *
            sqrt(
                segmentTransmittance);


        vec3 sunTransmittance =
            sampleTransmittanceToSpace(
                samplePosition,
                sunDirection);


        vec3 directScatteringSource =
            rayleighScatteringPerKm *
            densityRayleigh *
            phaseRayleigh
            +
            mieScatteringPerKm *
            densityMie *
            phaseMie;


        vec3 directRadianceSource =
            sunRadiance *
            sunTransmittance *
            directScatteringSource;


        vec3 multipleIncidentRadiance =
            sampleMultipleScattering(
                samplePosition,
                sunDirection)
            *
            sunRadiance;


        vec3 multipleRadianceSource =
            localScattering *
            multipleIncidentRadiance;


        accumulatedRadiance +=
            midpointViewTransmittance *
            (
                directRadianceSource +
                multipleRadianceSource
            )
            *
            stepLength;


        viewTransmittance *=
            segmentTransmittance;
    }


    imageStore(
        skyViewLut,
        pixel,
        vec4(
            accumulatedRadiance,
            1.0));
}