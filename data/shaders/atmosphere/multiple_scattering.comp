#version 450 core


layout(
    local_size_x = 8,
    local_size_y = 8,
    local_size_z = 1
) in;


layout(binding = 2)
uniform sampler2D transmittanceLut;


layout(
    rgba16f,
    binding = 0
)
writeonly uniform image2D multipleScatteringLut;


// =============================================================
// ATMOSPHERE
// =============================================================

uniform float bottomRadiusKm;
uniform float topRadiusKm;


uniform vec3 rayleighScatteringPerKm;
uniform float rayleighScaleHeightKm;


uniform vec3 mieScatteringPerKm;
uniform vec3 mieExtinctionPerKm;
uniform float mieScaleHeightKm;
uniform float mieAnisotropy;


uniform vec3 ozoneAbsorptionPerKm;
uniform float ozoneCenterHeightKm;
uniform float ozoneHalfWidthKm;


uniform vec3 groundAlbedo;


// =============================================================
// CONSTANTS
// =============================================================

const float PI =
    3.14159265359;


const int DIRECTION_COUNT =
    64;


const int RAY_SAMPLE_COUNT =
    20;


// =============================================================
// DENSITY
// =============================================================

float rayleighDensity(
    float altitudeKm)
{
    return exp(
        -max(
            altitudeKm,
            0.0)
        /
        rayleighScaleHeightKm);
}


float mieDensity(
    float altitudeKm)
{
    return exp(
        -max(
            altitudeKm,
            0.0)
        /
        mieScaleHeightKm);
}


float ozoneDensity(
    float altitudeKm)
{
    float distanceFromLayer =
        abs(
            altitudeKm -
            ozoneCenterHeightKm);


    return max(
        0.0,
        1.0 -
        distanceFromLayer /
        ozoneHalfWidthKm);
}


// =============================================================
// ATMOSPHERIC COEFFICIENTS
// =============================================================

vec3 scatteringAtAltitude(
    float altitudeKm)
{
    return
        rayleighScatteringPerKm *
        rayleighDensity(
            altitudeKm)
        +
        mieScatteringPerKm *
        mieDensity(
            altitudeKm);
}


vec3 extinctionAtAltitude(
    float altitudeKm)
{
    return
        rayleighScatteringPerKm *
        rayleighDensity(
            altitudeKm)
        +
        mieExtinctionPerKm *
        mieDensity(
            altitudeKm)
        +
        ozoneAbsorptionPerKm *
        ozoneDensity(
            altitudeKm);
}


// =============================================================
// RAY / SPHERE
// =============================================================

float nearestSphereIntersection(
    vec3 origin,
    vec3 direction,
    float radius)
{
    float b =
        dot(
            origin,
            direction);


    float c =
        dot(
            origin,
            origin)
        -
        radius *
        radius;


    float discriminant =
        b *
        b -
        c;


    if (discriminant < 0.0)
    {
        return
            -1.0;
    }


    float root =
        sqrt(
            discriminant);


    float nearDistance =
        -b -
        root;


    float farDistance =
        -b +
        root;


    if (nearDistance > 0.0001)
    {
        return
            nearDistance;
    }


    if (farDistance > 0.0001)
    {
        return
            farDistance;
    }


    return
        -1.0;
}


bool rayHitsGround(
    vec3 position,
    vec3 direction)
{
    float hitDistance =
        nearestSphereIntersection(
            position,
            direction,
            bottomRadiusKm);


    return
        hitDistance >
        0.0001;
}


// =============================================================
// TRANSMITTANCE LUT MAPPING
// =============================================================

vec2 transmittanceUv(
    vec3 position,
    vec3 direction)
{
    float radius =
        length(
            position);


    vec3 localUp =
        position /
        radius;


    float mu =
        clamp(
            dot(
                localUp,
                direction),
            -1.0,
            1.0);


    float H =
        sqrt(
            max(
                topRadiusKm *
                topRadiusKm
                -
                bottomRadiusKm *
                bottomRadiusKm,
                0.0));


    float rho =
        sqrt(
            max(
                radius *
                radius
                -
                bottomRadiusKm *
                bottomRadiusKm,
                0.0));


    float discriminant =
        radius *
        radius *
        (
            mu *
            mu -
            1.0
        )
        +
        topRadiusKm *
        topRadiusKm;


    float distanceToTop =
        -radius *
        mu
        +
        sqrt(
            max(
                discriminant,
                0.0));


    float distanceMinimum =
        topRadiusKm -
        radius;


    float distanceMaximum =
        rho +
        H;


    float xMu =
        (
            distanceToTop -
            distanceMinimum
        )
        /
        max(
            distanceMaximum -
            distanceMinimum,
            0.000001);


    float xRadius =
        rho /
        max(
            H,
            0.000001);


    vec2 parameterUv =
        clamp(
            vec2(
                xMu,
                xRadius),
            vec2(0.0),
            vec2(1.0));


    // Convert mathematical [0,1] coordinates into texel-center
    // coordinates. This prevents filtering from sampling beyond
    // the meaningful LUT domain.
    vec2 textureSizePixels =
        vec2(
            textureSize(
                transmittanceLut,
                0));


    return
        (
            parameterUv *
            (
                textureSizePixels -
                vec2(1.0)
            )
            +
            vec2(0.5)
        )
        /
        textureSizePixels;
}


vec3 sampleTransmittanceToSpace(
    vec3 position,
    vec3 direction)
{
    // This discontinuity belongs to PLANET GEOMETRY,
    // not inside a linearly-filtered texture.
    if (rayHitsGround(
            position,
            direction))
    {
        return
            vec3(0.0);
    }


    return textureLod(
        transmittanceLut,
        transmittanceUv(
            position,
            direction),
        0.0).rgb;
}


// =============================================================
// PHASE FUNCTIONS
// =============================================================

float rayleighPhase(
    float cosTheta)
{
    return
        3.0 /
        (
            16.0 *
            PI
        )
        *
        (
            1.0 +
            cosTheta *
            cosTheta
        );
}


float miePhase(
    float cosTheta,
    float g)
{
    float g2 =
        g *
        g;


    float denominator =
        1.0 +
        g2 -
        2.0 *
        g *
        cosTheta;


    return
        (
            1.0 -
            g2
        )
        /
        (
            4.0 *
            PI *
            pow(
                max(
                    denominator,
                    0.0001),
                1.5)
        );
}


// =============================================================
// SPHERE SAMPLE DIRECTIONS
// =============================================================

vec3 sphereDirection(
    int index)
{
    float i =
        float(index)
        +
        0.5;


    float count =
        float(
            DIRECTION_COUNT);


    float z =
        1.0 -
        2.0 *
        i /
        count;


    float radius =
        sqrt(
            max(
                1.0 -
                z *
                z,
                0.0));


    const float goldenAngle =
        2.399963229728653;


    float phi =
        goldenAngle *
        i;


    return vec3(
        cos(phi) *
        radius,

        sin(phi) *
        radius,

        z);
}


// =============================================================
// INTEGRATE ONE DIRECTION
// =============================================================

void integrateDirection(
    vec3 position,
    vec3 rayDirection,
    vec3 sunDirection,
    out vec3 firstOrderRadiance,
    out vec3 isotropicTransport)
{
    firstOrderRadiance =
        vec3(0.0);


    isotropicTransport =
        vec3(0.0);


    float distanceToTop =
        nearestSphereIntersection(
            position,
            rayDirection,
            topRadiusKm);


    if (distanceToTop < 0.0)
    {
        return;
    }


    float distanceToGround =
        nearestSphereIntersection(
            position,
            rayDirection,
            bottomRadiusKm);


    bool hitsGround =
        distanceToGround > 0.0
        &&
        distanceToGround <
        distanceToTop;


    float rayLength =
        hitsGround
            ? distanceToGround
            : distanceToTop;


    float stepLength =
        rayLength /
        float(
            RAY_SAMPLE_COUNT);


    vec3 rayTransmittance =
        vec3(1.0);


    float scatteringAngleCosine =
        clamp(
            dot(
                rayDirection,
                sunDirection),
            -1.0,
            1.0);


    float phaseRayleigh =
        rayleighPhase(
            scatteringAngleCosine);


    float phaseMie =
        miePhase(
            scatteringAngleCosine,
            mieAnisotropy);


    for (int sampleIndex = 0;
         sampleIndex < RAY_SAMPLE_COUNT;
         ++sampleIndex)
    {
        float distanceAlongRay =
            (
                float(sampleIndex) +
                0.5
            )
            *
            stepLength;


        vec3 samplePosition =
            position +
            rayDirection *
            distanceAlongRay;


        float altitudeKm =
            max(
                length(
                    samplePosition)
                -
                bottomRadiusKm,
                0.0);


        float densityRayleigh =
            rayleighDensity(
                altitudeKm);


        float densityMie =
            mieDensity(
                altitudeKm);


        vec3 localScattering =
            scatteringAtAltitude(
                altitudeKm);


        vec3 localExtinction =
            extinctionAtAltitude(
                altitudeKm);


        vec3 segmentTransmittance =
            exp(
                -localExtinction *
                stepLength);


        vec3 midpointTransmittance =
            rayTransmittance *
            sqrt(
                segmentTransmittance);


        vec3 sunTransmittance =
            sampleTransmittanceToSpace(
                samplePosition,
                sunDirection);


        vec3 directScattering =
            rayleighScatteringPerKm *
            densityRayleigh *
            phaseRayleigh
            +
            mieScatteringPerKm *
            densityMie *
            phaseMie;


        firstOrderRadiance +=
            midpointTransmittance *
            sunTransmittance *
            directScattering *
            stepLength;


        isotropicTransport +=
            midpointTransmittance *
            localScattering *
            stepLength;


        rayTransmittance *=
            segmentTransmittance;
    }


    if (hitsGround)
    {
        vec3 groundPosition =
            position +
            rayDirection *
            rayLength;


        vec3 groundNormal =
            normalize(
                groundPosition);


        float groundSunCosine =
            max(
                dot(
                    groundNormal,
                    sunDirection),
                0.0);


        if (groundSunCosine > 0.0)
        {
            vec3 groundSunTransmittance =
                sampleTransmittanceToSpace(
                    groundPosition
                    +
                    groundNormal *
                    0.001,
                    sunDirection);


            vec3 groundRadiance =
                groundAlbedo *
                groundSunTransmittance *
                groundSunCosine /
                PI;


            firstOrderRadiance +=
                rayTransmittance *
                groundRadiance;
        }
    }
}


// =============================================================
// MAIN
// =============================================================

void main()
{
    ivec2 size =
        imageSize(
            multipleScatteringLut);


    ivec2 pixel =
        ivec2(
            gl_GlobalInvocationID.xy);


    if (pixel.x >= size.x ||
        pixel.y >= size.y)
    {
        return;
    }


    vec2 uv =
        (
            vec2(pixel) +
            vec2(0.5)
        )
        /
        vec2(size);


    float sunMu =
        uv.x *
        2.0 -
        1.0;


    float sunHorizontal =
        sqrt(
            max(
                1.0 -
                sunMu *
                sunMu,
                0.0));


    vec3 sunDirection =
        normalize(
            vec3(
                sunHorizontal,
                0.0,
                sunMu));


    float atmosphereThickness =
        topRadiusKm -
        bottomRadiusKm;


    float altitudeKm =
        uv.y *
        atmosphereThickness;


    float radius =
        bottomRadiusKm +
        altitudeKm;


    radius =
        clamp(
            radius,
            bottomRadiusKm +
            0.001,
            topRadiusKm -
            0.001);


    vec3 position =
        vec3(
            0.0,
            0.0,
            radius);


    vec3 averageFirstOrder =
        vec3(0.0);


    vec3 averageTransport =
        vec3(0.0);


    for (int directionIndex = 0;
         directionIndex < DIRECTION_COUNT;
         ++directionIndex)
    {
        vec3 rayDirection =
            sphereDirection(
                directionIndex);


        vec3 firstOrder;
        vec3 transport;


        integrateDirection(
            position,
            rayDirection,
            sunDirection,
            firstOrder,
            transport);


        averageFirstOrder +=
            firstOrder;


        averageTransport +=
            transport;
    }


    averageFirstOrder /=
        float(
            DIRECTION_COUNT);


    averageTransport /=
        float(
            DIRECTION_COUNT);


    vec3 denominator =
        max(
            vec3(1.0) -
            averageTransport,
            vec3(0.05));


    vec3 multipleScattering =
        averageFirstOrder /
        denominator;


    imageStore(
        multipleScatteringLut,
        pixel,
        vec4(
            multipleScattering,
            1.0));
}