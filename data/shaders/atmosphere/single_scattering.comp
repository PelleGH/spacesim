#version 450 core


layout(
    local_size_x = 8,
    local_size_y = 8,
    local_size_z = 1
) in;


// =============================================================
// INPUT / OUTPUT
// =============================================================

// Our already-computed transmittance LUT.
layout(binding = 2)
uniform sampler2D transmittanceLut;


// Output:
// RGB atmospheric radiance visible from the test observer.
layout(
    rgba16f,
    binding = 0
)
writeonly uniform image2D singleScatteringLut;


// =============================================================
// ATMOSPHERE PARAMETERS
// =============================================================

uniform float bottomRadiusKm;

uniform float topRadiusKm;


uniform vec3 rayleighScatteringPerKm;

uniform float rayleighScaleHeightKm;


uniform vec3 mieScatteringPerKm;

uniform vec3 mieExtinctionPerKm;

uniform float mieScaleHeightKm;

uniform float mieAnisotropy;


uniform vec3 ozoneAbsorptionPerKm;

uniform float ozoneCenterHeightKm;

uniform float ozoneHalfWidthKm;


// =============================================================
// TEST VIEW PARAMETERS
// =============================================================

// Observer altitude above the surface.
uniform float cameraAltitudeKm;

// Cosine of sun zenith angle.
//
// 1   = sun directly overhead
// 0   = sun on horizon
// -1  = sun below horizon
uniform float sunZenithCosine;

// HDR solar radiance used by this debug atmosphere.
uniform vec3 sunRadiance;


// =============================================================
// CONSTANTS
// =============================================================

const float PI =
    3.14159265359;


const int VIEW_SAMPLE_COUNT =
    48;


// =============================================================
// DENSITY PROFILES
// =============================================================

float rayleighDensity(
    float altitudeKm)
{
    return exp(
        -max(
            altitudeKm,
            0.0)
        /
        rayleighScaleHeightKm);
}


float mieDensity(
    float altitudeKm)
{
    return exp(
        -max(
            altitudeKm,
            0.0)
        /
        mieScaleHeightKm);
}


float ozoneDensity(
    float altitudeKm)
{
    float distanceFromLayer =
        abs(
            altitudeKm -
            ozoneCenterHeightKm);


    return max(
        0.0,
        1.0 -
        distanceFromLayer /
        ozoneHalfWidthKm);
}


// =============================================================
// EXTINCTION
// =============================================================

vec3 extinctionAtAltitude(
    float altitudeKm)
{
    return
        rayleighScatteringPerKm *
        rayleighDensity(
            altitudeKm)
        +
        mieExtinctionPerKm *
        mieDensity(
            altitudeKm)
        +
        ozoneAbsorptionPerKm *
        ozoneDensity(
            altitudeKm);
}


// =============================================================
// RAY / SPHERE INTERSECTION
// =============================================================

// Returns the nearest positive ray/sphere intersection.
//
// Negative means no valid forward intersection.
float nearestSphereIntersection(
    vec3 origin,
    vec3 direction,
    float radius)
{
    float b =
        dot(
            origin,
            direction);


    float c =
        dot(
            origin,
            origin)
        -
        radius *
        radius;


    float discriminant =
        b *
        b
        -
        c;


    if (discriminant < 0.0)
    {
        return
            -1.0;
    }


    float root =
        sqrt(
            discriminant);


    float nearDistance =
        -b -
        root;


    float farDistance =
        -b +
        root;


    if (nearDistance > 0.0001)
    {
        return
            nearDistance;
    }


    if (farDistance > 0.0001)
    {
        return
            farDistance;
    }


    return
        -1.0;
}


// =============================================================
// TRANSMITTANCE LUT LOOKUP
// =============================================================

// Same parameterization as transmittance.comp:
//
// X = local ray cosine
// Y = altitude
vec3 sampleTransmittanceToSpace(
    vec3 position,
    vec3 direction)
{
    float radius =
        length(
            position);


    vec3 localUp =
        position /
        radius;


    float mu =
        clamp(
            dot(
                localUp,
                direction),
            -1.0,
            1.0);


    float u =
        mu *
        0.5 +
        0.5;


    float atmosphereThickness =
        topRadiusKm -
        bottomRadiusKm;


    float altitudeKm =
        radius -
        bottomRadiusKm;


    float v =
        clamp(
            altitudeKm /
            atmosphereThickness,
            0.0,
            1.0);


    return texture(
        transmittanceLut,
        vec2(
            u,
            v)).rgb;
}


// =============================================================
// PHASE FUNCTIONS
// =============================================================

// Rayleigh scatters in both forward and backward directions.
float rayleighPhase(
    float cosTheta)
{
    return
        3.0 /
        (
            16.0 *
            PI
        )
        *
        (
            1.0 +
            cosTheta *
            cosTheta
        );
}


// Henyey-Greenstein-style Mie phase.
//
// Positive g produces strong forward scattering.
//
// This is responsible for the bright haze around the sun.
float miePhase(
    float cosTheta,
    float g)
{
    float g2 =
        g *
        g;


    float denominator =
        1.0 +
        g2 -
        2.0 *
        g *
        cosTheta;


    return
        (
            1.0 -
            g2
        )
        /
        (
            4.0 *
            PI *
            pow(
                max(
                    denominator,
                    0.0001),
                1.5)
        );
}


// =============================================================
// VIEW DIRECTION FROM LUT COORDINATES
// =============================================================

vec3 buildViewDirection(
    vec2 uv)
{
    // X = full 360 degree azimuth.
    //
    // uv.x = 0.5 points toward +X.
    float azimuth =
        (
            uv.x *
            2.0 -
            1.0
        )
        *
        PI;


    // Y:
    //
    // 0 = straight upward
    // .5 = horizon
    // 1 = straight downward
    float zenithAngle =
        uv.y *
        PI;


    float sinZenith =
        sin(
            zenithAngle);


    return normalize(
        vec3(
            cos(
                azimuth)
            *
            sinZenith,

            sin(
                azimuth)
            *
            sinZenith,

            cos(
                zenithAngle)));
}


// =============================================================
// MAIN
// =============================================================

void main()
{
    ivec2 size =
        imageSize(
            singleScatteringLut);


    ivec2 pixel =
        ivec2(
            gl_GlobalInvocationID.xy);


    if (pixel.x >= size.x ||
        pixel.y >= size.y)
    {
        return;
    }


    vec2 uv =
        (
            vec2(
                pixel)
            +
            vec2(
                0.5)
        )
        /
        vec2(
            size);


    // =========================================================
    // CAMERA
    // =========================================================

    float cameraRadius =
        bottomRadiusKm +
        cameraAltitudeKm;


    // Put the observer on the planet's +Z axis.
    vec3 cameraPosition =
        vec3(
            0.0,
            0.0,
            cameraRadius);


    vec3 viewDirection =
        buildViewDirection(
            uv);


    // =========================================================
    // SUN
    // =========================================================

    float safeSunCosine =
        clamp(
            sunZenithCosine,
            -1.0,
            1.0);


    float sunHorizontal =
        sqrt(
            max(
                1.0 -
                safeSunCosine *
                safeSunCosine,
                0.0));


    // Sun is intentionally placed at azimuth zero so it appears
    // around the horizontal center of our debug map.
    vec3 sunDirection =
        normalize(
            vec3(
                sunHorizontal,
                0.0,
                safeSunCosine));


    // =========================================================
    // DETERMINE HOW FAR THE VIEW RAY TRAVELS
    // =========================================================

    float distanceToAtmosphere =
        nearestSphereIntersection(
            cameraPosition,
            viewDirection,
            topRadiusKm);


    if (distanceToAtmosphere < 0.0)
    {
        imageStore(
            singleScatteringLut,
            pixel,
            vec4(
                0.0,
                0.0,
                0.0,
                1.0));


        return;
    }


    float distanceToGround =
        nearestSphereIntersection(
            cameraPosition,
            viewDirection,
            bottomRadiusKm);


    float rayLength =
        distanceToAtmosphere;


    // If we hit the planet first, only integrate atmosphere
    // down to the surface.
    if (distanceToGround > 0.0 &&
        distanceToGround <
        rayLength)
    {
        rayLength =
            distanceToGround;
    }


    float stepLength =
        rayLength /
        float(
            VIEW_SAMPLE_COUNT);


    // =========================================================
    // SCATTERING ANGLE
    // =========================================================

    // Looking toward the sun gives cosTheta near +1,
    // which makes the Mie forward-scattering lobe bright.
    float cosTheta =
        clamp(
            dot(
                viewDirection,
                sunDirection),
            -1.0,
            1.0);


    float phaseRayleigh =
        rayleighPhase(
            cosTheta);


    float phaseMie =
        miePhase(
            cosTheta,
            mieAnisotropy);


    // =========================================================
    // INTEGRATE ALONG THE CAMERA RAY
    // =========================================================

    vec3 accumulatedRadiance =
        vec3(
            0.0);


    // How much light survives from the current sample
    // back toward the camera.
    vec3 viewTransmittance =
        vec3(
            1.0);


    for (int i = 0;
         i < VIEW_SAMPLE_COUNT;
         ++i)
    {
        float distanceAlongRay =
            (
                float(i) +
                0.5
            )
            *
            stepLength;


        vec3 samplePosition =
            cameraPosition +
            viewDirection *
            distanceAlongRay;


        float sampleRadius =
            length(
                samplePosition);


        float altitudeKm =
            max(
                sampleRadius -
                bottomRadiusKm,
                0.0);


        // -----------------------------------------------------
        // LOCAL ATMOSPHERIC DENSITY
        // -----------------------------------------------------

        float densityRayleigh =
            rayleighDensity(
                altitudeKm);


        float densityMie =
            mieDensity(
                altitudeKm);


        vec3 localExtinction =
            extinctionAtAltitude(
                altitudeKm);


        // -----------------------------------------------------
        // CAMERA -> SAMPLE TRANSMITTANCE
        // -----------------------------------------------------

        // Approximate transmittance across this small segment.
        vec3 segmentTransmittance =
            exp(
                -localExtinction *
                stepLength);


        // Midpoint estimate is slightly better than using either
        // endpoint of the segment.
        vec3 midpointViewTransmittance =
            viewTransmittance *
            sqrt(
                segmentTransmittance);


        // -----------------------------------------------------
        // SUN -> SAMPLE TRANSMITTANCE
        // -----------------------------------------------------

        vec3 sunTransmittance =
            sampleTransmittanceToSpace(
                samplePosition,
                sunDirection);


        // -----------------------------------------------------
        // LIGHT SCATTERED AT THIS SAMPLE
        // -----------------------------------------------------

        vec3 rayleighSource =
            rayleighScatteringPerKm *
            densityRayleigh *
            phaseRayleigh;


        vec3 mieSource =
            mieScatteringPerKm *
            densityMie *
            phaseMie;


        vec3 scatteringSource =
            rayleighSource +
            mieSource;


        vec3 sampleRadiance =
            sunRadiance *
            sunTransmittance *
            midpointViewTransmittance *
            scatteringSource *
            stepLength;


        accumulatedRadiance +=
            sampleRadiance;


        // Advance cumulative camera transmittance.
        viewTransmittance *=
            segmentTransmittance;
    }


    imageStore(
        singleScatteringLut,
        pixel,
        vec4(
            accumulatedRadiance,
            1.0));
}