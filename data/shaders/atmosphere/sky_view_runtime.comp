#version 450 core


layout(
    local_size_x = 8,
    local_size_y = 8,
    local_size_z = 1
) in;


layout(binding = 2)
uniform sampler2D transmittanceLut;


layout(binding = 3)
uniform sampler2D multipleScatteringLut;


layout(
    rgba16f,
    binding = 0
)
writeonly uniform image2D skyViewLut;


// =============================================================
// CAMERA
// =============================================================

uniform vec3 cameraPositionWorld;


// These are still supplied by AtmosphereViewLuts.
//
// The Sky-View LUT no longer depends on camera orientation/FOV,
// but leaving these uniforms supplied from C++ is harmless.
uniform vec3 cameraForward;
uniform vec3 cameraRight;
uniform vec3 cameraUp;

uniform float tanHalfFov;
uniform float aspectRatio;


// =============================================================
// PLANET / ATMOSPHERE
// =============================================================

uniform vec3 planetCenterWorld;

uniform float kmPerWorldUnit;


uniform float bottomRadiusKm;

uniform float topRadiusKm;


uniform vec3 rayleighScatteringPerKm;

uniform float rayleighScaleHeightKm;


uniform vec3 mieScatteringPerKm;

uniform vec3 mieExtinctionPerKm;

uniform float mieScaleHeightKm;

uniform float mieAnisotropy;


uniform vec3 ozoneAbsorptionPerKm;

uniform float ozoneCenterHeightKm;

uniform float ozoneHalfWidthKm;


uniform vec3 sunDirection;

uniform vec3 sunRadiance;


// =============================================================
// CONSTANTS
// =============================================================

const float PI =
    3.14159265359;


// Each side of closest approach receives this many intervals.
//
// Most rays only use one side.
//
// Grazing rays can use both, concentrating samples around the
// dense part of the atmosphere.
const int SAMPLES_PER_SEGMENT =
    16;


// =============================================================
// DENSITY
// =============================================================

float rayleighDensity(
    float altitudeKm)
{
    return exp(
        -max(
            altitudeKm,
            0.0)
        /
        rayleighScaleHeightKm);
}


float mieDensity(
    float altitudeKm)
{
    return exp(
        -max(
            altitudeKm,
            0.0)
        /
        mieScaleHeightKm);
}


float ozoneDensity(
    float altitudeKm)
{
    float distanceFromLayer =
        abs(
            altitudeKm -
            ozoneCenterHeightKm);


    return max(
        0.0,
        1.0 -
        distanceFromLayer /
        ozoneHalfWidthKm);
}


vec3 scatteringAtAltitude(
    float altitudeKm)
{
    return
        rayleighScatteringPerKm *
        rayleighDensity(
            altitudeKm)
        +
        mieScatteringPerKm *
        mieDensity(
            altitudeKm);
}


vec3 extinctionAtAltitude(
    float altitudeKm)
{
    return
        rayleighScatteringPerKm *
        rayleighDensity(
            altitudeKm)
        +
        mieExtinctionPerKm *
        mieDensity(
            altitudeKm)
        +
        ozoneAbsorptionPerKm *
        ozoneDensity(
            altitudeKm);
}


// =============================================================
// NUMERICALLY-STABLE RAY / SPHERE INTERSECTION
// =============================================================
//
// Sky calculations use physical kilometres.
//
// To avoid doing tangent intersection math with radii around
// 6360 directly, normalize the planet radius close to 1 first,
// then convert the resulting ray distance back into kilometres.

bool raySphereIntervalKm(
    vec3 originKm,
    vec3 direction,
    float sphereRadiusKm,
    out float tNearKm,
    out float tFarKm)
{
    float scale =
        bottomRadiusKm;


    vec3 origin =
        originKm /
        scale;


    float radius =
        sphereRadiusKm /
        scale;


    float b =
        dot(
            origin,
            direction);


    float c =
        dot(
            origin,
            origin)
        -
        radius *
        radius;


    float discriminant =
        b *
        b -
        c;


    if (discriminant < 0.0)
    {
        tNearKm =
            -1.0;

        tFarKm =
            -1.0;

        return false;
    }


    float root =
        sqrt(
            max(
                discriminant,
                0.0));


    tNearKm =
        (
            -b -
            root
        )
        *
        scale;


    tFarKm =
        (
            -b +
            root
        )
        *
        scale;


    return
        tFarKm >
        0.0;
}


float nearestSphereIntersectionKm(
    vec3 originKm,
    vec3 direction,
    float sphereRadiusKm)
{
    float tNear;

    float tFar;


    if (!raySphereIntervalKm(
            originKm,
            direction,
            sphereRadiusKm,
            tNear,
            tFar))
    {
        return
            -1.0;
    }


    if (tNear > 0.000001)
    {
        return
            tNear;
    }


    if (tFar > 0.000001)
    {
        return
            tFar;
    }


    return
        -1.0;
}


// =============================================================
// TRANSMITTANCE LUT
// =============================================================

bool rayHitsGroundKm(
    vec3 positionKm,
    vec3 direction)
{
    return
        nearestSphereIntersectionKm(
            positionKm,
            direction,
            bottomRadiusKm)
        >
        0.000001;
}


vec2 transmittanceUv(
    vec3 positionKm,
    vec3 direction)
{
    float radiusKm =
        length(
            positionKm);


    vec3 localUp =
        positionKm /
        radiusKm;


    float mu =
        clamp(
            dot(
                localUp,
                direction),
            -1.0,
            1.0);


    float radius =
        radiusKm /
        bottomRadiusKm;


    float topRadius =
        topRadiusKm /
        bottomRadiusKm;


    const float bottomRadius =
        1.0;


    float H =
        sqrt(
            max(
                topRadius *
                topRadius
                -
                bottomRadius *
                bottomRadius,
                0.0));


    float rho =
        sqrt(
            max(
                radius *
                radius
                -
                bottomRadius *
                bottomRadius,
                0.0));


    float discriminant =
        radius *
        radius *
        (
            mu *
            mu -
            1.0
        )
        +
        topRadius *
        topRadius;


    float distanceToTop =
        -radius *
        mu
        +
        sqrt(
            max(
                discriminant,
                0.0));


    float distanceMinimum =
        topRadius -
        radius;


    float distanceMaximum =
        rho +
        H;


    float xMu =
        (
            distanceToTop -
            distanceMinimum
        )
        /
        max(
            distanceMaximum -
            distanceMinimum,
            0.000001);


    float xRadius =
        rho /
        max(
            H,
            0.000001);


    vec2 parameterUv =
        clamp(
            vec2(
                xMu,
                xRadius),
            vec2(0.0),
            vec2(1.0));


    vec2 textureSizePixels =
        vec2(
            textureSize(
                transmittanceLut,
                0));


    return
        (
            parameterUv *
            (
                textureSizePixels -
                vec2(1.0)
            )
            +
            vec2(0.5)
        )
        /
        textureSizePixels;
}


vec3 sampleTransmittanceToSpace(
    vec3 positionKm,
    vec3 direction)
{
    if (rayHitsGroundKm(
            positionKm,
            direction))
    {
        return
            vec3(0.0);
    }


    return textureLod(
        transmittanceLut,
        transmittanceUv(
            positionKm,
            direction),
        0.0).rgb;
}


// =============================================================
// MULTIPLE SCATTERING
// =============================================================

vec3 sampleMultipleScattering(
    vec3 positionKm,
    vec3 directionToSun)
{
    float radiusKm =
        length(
            positionKm);


    vec3 localUp =
        positionKm /
        radiusKm;


    float sunMu =
        clamp(
            dot(
                localUp,
                directionToSun),
            -1.0,
            1.0);


    float u =
        sunMu *
        0.5 +
        0.5;


    float altitudeKm =
        radiusKm -
        bottomRadiusKm;


    float atmosphereThicknessKm =
        topRadiusKm -
        bottomRadiusKm;


    float v =
        clamp(
            altitudeKm /
            atmosphereThicknessKm,
            0.0,
            1.0);


    return textureLod(
        multipleScatteringLut,
        vec2(
            u,
            v),
        0.0).rgb;
}


// =============================================================
// PHASE FUNCTIONS
// =============================================================

float rayleighPhase(
    float cosTheta)
{
    return
        3.0 /
        (
            16.0 *
            PI
        )
        *
        (
            1.0 +
            cosTheta *
            cosTheta
        );
}


float miePhase(
    float cosTheta,
    float g)
{
    float g2 =
        g *
        g;


    float denominator =
        1.0 +
        g2 -
        2.0 *
        g *
        cosTheta;


    return
        (
            1.0 -
            g2
        )
        /
        (
            4.0 *
            PI *
            pow(
                max(
                    denominator,
                    0.0001),
                1.5)
        );
}


// =============================================================
// SKY-VIEW LUT PARAMETERIZATION
// =============================================================
//
// This is the important part.
//
// U is the view azimuth relative to the sun.
//
// V is the view zenith angle relative to the local horizon.
//
// The V mapping is NON-LINEAR so substantially more texels are
// concentrated near the horizon.
//
// That is where atmospheric radiance changes fastest.

vec2 subUvToUnitUv(
    vec2 uv,
    vec2 textureSizePixels)
{
    return
        clamp(
            (
                uv *
                textureSizePixels
                -
                vec2(0.5)
            )
            /
            max(
                textureSizePixels -
                vec2(1.0),
                vec2(1.0)),
            vec2(0.0),
            vec2(1.0));
}


void uvToSkyViewParameters(
    vec2 textureUv,
    vec2 textureSizePixels,
    float viewHeightKm,
    out float viewZenithCosAngle,
    out float lightViewCosAngle)
{
    vec2 uv =
        subUvToUnitUv(
            textureUv,
            textureSizePixels);


    float horizonDistance =
        sqrt(
            max(
                viewHeightKm *
                viewHeightKm
                -
                bottomRadiusKm *
                bottomRadiusKm,
                0.0));


    float cosBeta =
        clamp(
            horizonDistance /
            max(
                viewHeightKm,
                0.000001),
            0.0,
            1.0);


    float beta =
        acos(
            cosBeta);


    // Angle from local zenith to the visible horizon.
    float zenithHorizonAngle =
        PI -
        beta;


    float viewZenithAngle;


    if (uv.y < 0.5)
    {
        // ---------------------------------------------------------
        // ABOVE THE HORIZON
        // ---------------------------------------------------------
        //
        // Undo the nonlinear horizon compression.

        float coord =
            uv.y *
            2.0;


        coord =
            1.0 -
            coord;


        coord *=
            coord;


        coord =
            1.0 -
            coord;


        viewZenithAngle =
            zenithHorizonAngle *
            coord;
    }
    else
    {
        // ---------------------------------------------------------
        // BELOW THE HORIZON / GROUND-FACING
        // ---------------------------------------------------------

        float coord =
            uv.y *
            2.0 -
            1.0;


        coord *=
            coord;


        viewZenithAngle =
            zenithHorizonAngle
            +
            beta *
            coord;
    }


    viewZenithCosAngle =
        cos(
            viewZenithAngle);


    // U was stored as:
    //
    // sqrt(-lightViewCos * 0.5 + 0.5)
    //
    // Undo it here.
    float azimuthCoord =
        uv.x *
        uv.x;


    lightViewCosAngle =
        1.0 -
        2.0 *
        azimuthCoord;


    lightViewCosAngle =
        clamp(
            lightViewCosAngle,
            -1.0,
            1.0);
}


// =============================================================
// NONLINEAR RAY SAMPLES
// =============================================================

float clusterTowardEnd(
    float u)
{
    float inverse =
        1.0 -
        u;


    return
        1.0 -
        inverse *
        inverse;
}


float clusterTowardStart(
    float u)
{
    return
        u *
        u;
}


// =============================================================
// INTEGRATION
// =============================================================

void integrateSegment(
    vec3 cameraPositionKm,
    vec3 rayDirection,
    vec3 directionToSun,
    float phaseRayleigh,
    float phaseMie,
    float segmentStartKm,
    float segmentEndKm,
    bool clusterAtStart,
    inout vec3 viewTransmittance,
    inout vec3 accumulatedRadiance)
{
    float segmentLengthKm =
        segmentEndKm -
        segmentStartKm;


    if (segmentLengthKm <= 0.000001)
    {
        return;
    }


    for (int i = 0;
         i < SAMPLES_PER_SEGMENT;
         ++i)
    {
        float u0 =
            float(i)
            /
            float(
                SAMPLES_PER_SEGMENT);


        float u1 =
            float(i + 1)
            /
            float(
                SAMPLES_PER_SEGMENT);


        float mapped0;

        float mapped1;


        if (clusterAtStart)
        {
            mapped0 =
                clusterTowardStart(
                    u0);


            mapped1 =
                clusterTowardStart(
                    u1);
        }
        else
        {
            mapped0 =
                clusterTowardEnd(
                    u0);


            mapped1 =
                clusterTowardEnd(
                    u1);
        }


        float sampleStartKm =
            mix(
                segmentStartKm,
                segmentEndKm,
                mapped0);


        float sampleEndKm =
            mix(
                segmentStartKm,
                segmentEndKm,
                mapped1);


        float stepLengthKm =
            sampleEndKm -
            sampleStartKm;


        float sampleDistanceKm =
            (
                sampleStartKm +
                sampleEndKm
            )
            *
            0.5;


        vec3 samplePositionKm =
            cameraPositionKm
            +
            rayDirection *
            sampleDistanceKm;


        float altitudeKm =
            max(
                length(
                    samplePositionKm)
                -
                bottomRadiusKm,
                0.0);


        float densityRayleigh =
            rayleighDensity(
                altitudeKm);


        float densityMie =
            mieDensity(
                altitudeKm);


        vec3 localExtinction =
            extinctionAtAltitude(
                altitudeKm);


        vec3 segmentTransmittance =
            exp(
                -localExtinction *
                stepLengthKm);


        vec3 midpointTransmittance =
            viewTransmittance
            *
            sqrt(
                segmentTransmittance);


        vec3 sunTransmittance =
            sampleTransmittanceToSpace(
                samplePositionKm,
                directionToSun);


        vec3 directScattering =
            rayleighScatteringPerKm
            *
            densityRayleigh
            *
            phaseRayleigh
            +
            mieScatteringPerKm
            *
            densityMie
            *
            phaseMie;


        vec3 directSource =
            sunRadiance
            *
            sunTransmittance
            *
            directScattering;


        vec3 multipleSource =
            scatteringAtAltitude(
                altitudeKm)
            *
            sampleMultipleScattering(
                samplePositionKm,
                directionToSun)
            *
            sunRadiance;


        accumulatedRadiance +=
            midpointTransmittance
            *
            (
                directSource +
                multipleSource
            )
            *
            stepLengthKm;


        viewTransmittance *=
            segmentTransmittance;
    }
}


// =============================================================
// MAIN
// =============================================================

void main()
{
    ivec2 size =
        imageSize(
            skyViewLut);


    ivec2 pixel =
        ivec2(
            gl_GlobalInvocationID.xy);


    if (pixel.x >= size.x ||
        pixel.y >= size.y)
    {
        return;
    }


    vec2 textureUv =
        (
            vec2(
                pixel)
            +
            vec2(0.5)
        )
        /
        vec2(
            size);


    // =========================================================
    // CAMERA HEIGHT
    // =========================================================

    vec3 cameraRelativeWorld =
        cameraPositionWorld -
        planetCenterWorld;


    vec3 actualCameraPositionKm =
        cameraRelativeWorld
        *
        kmPerWorldUnit;


    float viewHeightKm =
        max(
            length(
                actualCameraPositionKm),
            bottomRadiusKm +
            0.001);


    // The LUT is rotationally symmetric around the planet.
    //
    // Therefore we can place the virtual camera on +Z while
    // preserving only its altitude.
    vec3 cameraPositionKm =
        vec3(
            0.0,
            0.0,
            viewHeightKm);


    // =========================================================
    // DECODE LUT -> ATMOSPHERIC VIEW DIRECTION
    // =========================================================

    float viewZenithCosAngle;

    float lightViewCosAngle;


    uvToSkyViewParameters(
        textureUv,
        vec2(
            size),
        viewHeightKm,
        viewZenithCosAngle,
        lightViewCosAngle);


    float viewZenithSinAngle =
        sqrt(
            max(
                1.0 -
                viewZenithCosAngle *
                viewZenithCosAngle,
                0.0));


    float lightViewSinAngle =
        sqrt(
            max(
                1.0 -
                lightViewCosAngle *
                lightViewCosAngle,
                0.0));


    vec3 rayDirection =
        normalize(
            vec3(
                viewZenithSinAngle *
                lightViewCosAngle,

                viewZenithSinAngle *
                lightViewSinAngle,

                viewZenithCosAngle));


    // =========================================================
    // PUT THE SUN IN THE SAME LOCAL REFERENTIAL
    // =========================================================

    vec3 actualLocalUp =
        normalize(
            actualCameraPositionKm);


    vec3 normalizedSunDirection =
        normalize(
            sunDirection);


    float sunZenithCosAngle =
        clamp(
            dot(
                actualLocalUp,
                normalizedSunDirection),
            -1.0,
            1.0);


    float sunHorizontal =
        sqrt(
            max(
                1.0 -
                sunZenithCosAngle *
                sunZenithCosAngle,
                0.0));


    vec3 localSunDirection =
        normalize(
            vec3(
                sunHorizontal,
                0.0,
                sunZenithCosAngle));


    // =========================================================
    // ATMOSPHERE INTERSECTION
    // =========================================================

    float atmosphereNearKm;

    float atmosphereFarKm;


    if (!raySphereIntervalKm(
            cameraPositionKm,
            rayDirection,
            topRadiusKm,
            atmosphereNearKm,
            atmosphereFarKm))
    {
        imageStore(
            skyViewLut,
            pixel,
            vec4(0.0));

        return;
    }


    float rayStartKm =
        max(
            atmosphereNearKm,
            0.0);


    float rayEndKm =
        atmosphereFarKm;


    float groundDistanceKm =
        nearestSphereIntersectionKm(
            cameraPositionKm,
            rayDirection,
            bottomRadiusKm);


    if (groundDistanceKm > rayStartKm &&
        groundDistanceKm < rayEndKm)
    {
        rayEndKm =
            groundDistanceKm;
    }


    if (rayEndKm <= rayStartKm)
    {
        imageStore(
            skyViewLut,
            pixel,
            vec4(0.0));

        return;
    }


    // =========================================================
    // PHASE
    // =========================================================

    float scatteringAngleCosine =
        clamp(
            dot(
                rayDirection,
                localSunDirection),
            -1.0,
            1.0);


    float phaseRayleigh =
        rayleighPhase(
            scatteringAngleCosine);


    float phaseMie =
        miePhase(
            scatteringAngleCosine,
            mieAnisotropy);


    // =========================================================
    // CLOSEST APPROACH
    // =========================================================

    float closestApproachKm =
        -dot(
            cameraPositionKm,
            rayDirection);


    closestApproachKm =
        clamp(
            closestApproachKm,
            rayStartKm,
            rayEndKm);


    vec3 accumulatedRadiance =
        vec3(0.0);


    vec3 viewTransmittance =
        vec3(1.0);


    // Entry/camera -> closest point.
    integrateSegment(
        cameraPositionKm,
        rayDirection,
        localSunDirection,
        phaseRayleigh,
        phaseMie,
        rayStartKm,
        closestApproachKm,
        false,
        viewTransmittance,
        accumulatedRadiance);


    // Closest point -> exit/ground.
    integrateSegment(
        cameraPositionKm,
        rayDirection,
        localSunDirection,
        phaseRayleigh,
        phaseMie,
        closestApproachKm,
        rayEndKm,
        true,
        viewTransmittance,
        accumulatedRadiance);


    imageStore(
        skyViewLut,
        pixel,
        vec4(
            accumulatedRadiance,
            1.0));
}