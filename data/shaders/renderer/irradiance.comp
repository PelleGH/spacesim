#version 450 core

layout(
    local_size_x = 8,
    local_size_y = 8,
    local_size_z = 1
) in;


// Source HDR environment.
layout(binding = 2)
uniform samplerCube environmentMap;


// Output irradiance cubemap.
layout(
    rgba16f,
    binding = 0
)
writeonly uniform imageCube irradianceMap;


const float PI =
    3.14159265359;

const uint SAMPLE_COUNT =
    128u;


// =============================================================
// CUBEMAP FACE -> WORLD DIRECTION
// =============================================================

vec3 cubeDirection(
    uint face,
    vec2 uv)
{
    if (face == 0u)
    {
        // +X
        return normalize(
            vec3(
                 1.0,
                -uv.y,
                -uv.x));
    }

    if (face == 1u)
    {
        // -X
        return normalize(
            vec3(
                -1.0,
                -uv.y,
                 uv.x));
    }

    if (face == 2u)
    {
        // +Y
        return normalize(
            vec3(
                 uv.x,
                 1.0,
                 uv.y));
    }

    if (face == 3u)
    {
        // -Y
        return normalize(
            vec3(
                 uv.x,
                -1.0,
                -uv.y));
    }

    if (face == 4u)
    {
        // +Z
        return normalize(
            vec3(
                 uv.x,
                -uv.y,
                 1.0));
    }

    // -Z
    return normalize(
        vec3(
            -uv.x,
            -uv.y,
            -1.0));
}


// =============================================================
// HAMMERSLEY SEQUENCE
// =============================================================

float radicalInverseVanDerCorput(
    uint bits)
{
    bits =
        (bits << 16u) |
        (bits >> 16u);

    bits =
        (
            (bits & 0x55555555u) << 1u
        ) |
        (
            (bits & 0xAAAAAAAAu) >> 1u
        );

    bits =
        (
            (bits & 0x33333333u) << 2u
        ) |
        (
            (bits & 0xCCCCCCCCu) >> 2u
        );

    bits =
        (
            (bits & 0x0F0F0F0Fu) << 4u
        ) |
        (
            (bits & 0xF0F0F0F0u) >> 4u
        );

    bits =
        (
            (bits & 0x00FF00FFu) << 8u
        ) |
        (
            (bits & 0xFF00FF00u) >> 8u
        );

    return
        float(bits) *
        2.3283064365386963e-10;
}


vec2 hammersley(
    uint index,
    uint count)
{
    return vec2(
        float(index) /
        float(count),

        radicalInverseVanDerCorput(
            index));
}


// =============================================================
// COSINE-WEIGHTED HEMISPHERE SAMPLE
// =============================================================

vec3 cosineSampleHemisphere(
    vec2 xi)
{
    float phi =
        2.0 *
        PI *
        xi.x;

    float sinTheta =
        sqrt(
            xi.y);

    float cosTheta =
        sqrt(
            1.0 -
            xi.y);

    return vec3(
        cos(phi) *
        sinTheta,

        sin(phi) *
        sinTheta,

        cosTheta);
}


// =============================================================
// MAIN
// =============================================================

void main()
{
    ivec2 size =
        imageSize(
            irradianceMap);

    ivec2 pixel =
        ivec2(
            gl_GlobalInvocationID.xy);

    uint face =
        gl_GlobalInvocationID.z;

    if (pixel.x >= size.x ||
        pixel.y >= size.y ||
        face >= 6u)
    {
        return;
    }


    // Convert texel center into [-1, +1].
    vec2 uv =
        (
            vec2(pixel) +
            vec2(0.5)
        ) /
        vec2(size);

    uv =
        uv *
        2.0 -
        1.0;


    vec3 N =
        cubeDirection(
            face,
            uv);


    // Build a tangent frame around N.
    vec3 helper =
        abs(N.z) < 0.999
            ? vec3(
                0.0,
                0.0,
                1.0)
            : vec3(
                1.0,
                0.0,
                0.0);

    vec3 tangent =
        normalize(
            cross(
                helper,
                N));

    vec3 bitangent =
        cross(
            N,
            tangent);


    vec3 accumulatedRadiance =
        vec3(0.0);


    for (uint i = 0u;
         i < SAMPLE_COUNT;
         ++i)
    {
        vec2 xi =
            hammersley(
                i,
                SAMPLE_COUNT);

        vec3 localDirection =
            cosineSampleHemisphere(
                xi);

        vec3 worldDirection =
            normalize(
                tangent *
                localDirection.x +

                bitangent *
                localDirection.y +

                N *
                localDirection.z);

        accumulatedRadiance +=
            texture(
                environmentMap,
                worldDirection).rgb;
    }


    // With cosine-weighted sampling:
    //
    // irradiance =
    //     PI * average(incoming radiance)
    //
    vec3 irradiance =
        PI *
        accumulatedRadiance /
        float(
            SAMPLE_COUNT);


    imageStore(
        irradianceMap,
        ivec3(
            pixel,
            int(face)),
        vec4(
            irradiance,
            1.0));
}