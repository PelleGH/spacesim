+    [[nodiscard]] AtmosphereParameters deriveAtmosphereParameters(
+        const ResolvedPlanet& planet);
+
+    [[nodiscard]] PlanetMaterial derivePlanetMaterial(
+        const ResolvedPlanet& planet);
+}
