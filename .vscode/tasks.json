{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure SpaceSim",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Visual Studio 18 2026",
                "-A",
                "x64"
            ],
            "problemMatcher": []
        },
        {
            "label": "build SpaceSim",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug"
            ],
            "dependsOn": "configure SpaceSim",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}